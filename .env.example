# Required: Upstash Redis credentials (auto-injected if you connect Vercel KV)
KV_REST_API_URL=https://...upstash.io
KV_REST_API_TOKEN=...

# Required: VAPID keys for Web Push (generate with: npm run vapid)
VAPID_PUBLIC_KEY=B...
VAPID_PRIVATE_KEY=...
VAPID_SUBJECT=mailto:junghun.lee@itcen.com

# Required: secret used by /api/refresh to authorize cron and manual triggers
# Generate any random string e.g. openssl rand -hex 32
CRON_SECRET=
